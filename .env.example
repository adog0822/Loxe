# Optional: Anthropic API key for enhanced AI-powered claim extraction
# Leave blank to use local heuristic extraction (works without any API key)
ANTHROPIC_API_KEY=

# Optional: OpenAI API key (alternative to Anthropic)
OPENAI_API_KEY=

# Search settings
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=10

# Output settings
OUTPUT_DIR=./output
DEFAULT_FORMAT=markdown
