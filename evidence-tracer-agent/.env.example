# Evidence Tracer Agent environment variables
# Copy this file to .env and fill in your values

# --- Mode ------------------------------------------------------------------
# Set to "true" to use synthetic demo data (no AWS or AI credentials needed)
DEMO_MODE=true

# --- AWS (live mode only) --------------------------------------------------
# Not used directly -- provide a Role ARN in the dashboard instead.
# The agent uses STS AssumeRole for secure cross-account access.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/EvidenceTracerReadOnly
# AWS_DEFAULT_REGION=us-east-1

# --- Claude API (live mode only) -------------------------------------------
# Required for real AI policy analysis. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# --- Auth0 (multi-user mode only) ------------------------------------------
# Create a Regular Web Application in your Auth0 dashboard.
# AUTH0_DOMAIN=my-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_CALLBACK_URL=http://localhost:8501
