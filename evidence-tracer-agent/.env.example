# Evidence Tracer Agent environment variables
# Copy this file to .env and fill in your values

# Set to true to run with simulated data (no credentials needed)
DEMO_MODE=true

# AWS Credentials (required when DEMO_MODE=false)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# OpenAI API Key (required when DEMO_MODE=false)
# OPENAI_API_KEY=
